# ==========================================================================
# glesmod -- .gitignore
#
# 策略：**默认忽略一切，只显式放行要提交的文件**。
#
# 为什么用白名单而不是黑名单：
#   本仓库的开发过程产生了大量临时产物（日志、反汇编、着色器导出、第三方
#   光影包副本）。黑名单只能挡住"想得到的"文件，而任何一个漏网之鱼都可能
#   把第三方版权内容（BSL 光影包、Mojang 提取代码）提交进 Git 历史 ——
#   一旦提交，即使之后删除，仍永久留在历史里。
#   白名单把风险方向反过来：新出现的文件默认*不*进入仓库，需要显式放行。
#
# 若发现某个应当提交的文件被忽略了，用 `git check-ignore -v <file>` 查原因，
# 然后在"显式放行"段落补一条规则。
#
# LGPL-3.0-or-later
# ==========================================================================

# ---- 1. 默认忽略 ---------------------------------------------------------
*

# ---- 2. 显式放行：仓库自身文件 -------------------------------------------
!.gitignore
!.gitattributes
!LICENSE
!README.md
!THIRD-PARTY-NOTICES.md
!TEMPLATE_LICENSE.txt
!开发任务书.txt

# ---- 2b. 显式放行：许可证正文副本 -----------------------------------------
# LGPL-3.0 第 3 条并入 GPL-3.0 条款，因此 GPL 全文是许可证的组成部分，
# 必须随仓库分发（详见 licenses/README.md）。
# 注意：不能只写 `!licenses/GPL-3.0.txt`，因为父目录 `licenses/` 本身
#      被默认规则 `*` 挡住了 —— Git 不会进入一个被忽略的目录，
#      必须先放行目录再放行内容。
!licenses/
!licenses/**

# ---- 3. 显式放行：构建脚本与配置 -----------------------------------------
!*.gradle
!gradle.properties
!gradlew
!gradlew.bat
!settings.gradle
!gradle/
!gradle/**
!gradle/wrapper/gradle-wrapper.jar

# ---- 4. 显式放行：NeoForge 模组源码 --------------------------------------
!src/
!src/**

# ---- 5. 显式放行：文档 ---------------------------------------------------
!docs/
!docs/**

# ---- 6. 显式放行：native 共享核心（.so 由启动器加载，源码必须入库）------
!native/
!native/**

# ---- 7. 显式放行：FCL 渲染器插件 -----------------------------------------
!fcl-plugin/
!fcl-plugin/**

# ---- 8. 显式放行：CI 配置 ------------------------------------------------
!.github/
!.github/**

# ==========================================================================
# 以下为**排除段**：在上面的 `!xxx/**` 之后重新挡住不该入库的内容。
# Git 按顺序处理规则，后出现的规则优先级更高（对同一条路径而言）。
# ==========================================================================

# ---- 构建产物 -----------------------------------------------------------
build/
**/build/
.gradle/
.gradle/**
run/
run/**
out/
bin/

# ---- 签名密钥（绝不能入库）----------------------------------------------
# fcl-plugin/build-plugin.ps1 在缺失时会自动重建调试密钥，
# 但它包含私钥材料，绝不应进入版本控制。
# ⚠️ 若将来替换为正式发布密钥，本规则是唯一的防线。
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key

# ---- 第三方光影包（BSL 等）—— 无再分发权 ---------------------------------
# 包含光影包本体、源码、导出、转换产物的一切形态。
BSL_*.zip
*.zip
bsl3/
bsl4/
bsl5/
bsl6/
bsl7/
bsl8/
bslsrc/
bsl_patched/
shader_bsl/
patched_shaders/
reconv/
reconv2/
reconv3/

# ---- 从 MC / NeoForge jar 提取的代码（含 Mojang 代码）--------------------
shader_dump/
native/tools/.cache/

# ---- 第三方着色器的逐字副本（见 native/tools/fixtures/README.md）---------
# Sodium 采用 Polyform Shield License（非 FOSS），逐字副本不可再分发。
# 该 fixture 可由 native/tools/fetch_sodium_shaders.ps1 随时重新获取。
native/tools/fixtures/sodium_chunk_0.8.13.vert

# ---- 陈旧备份 -----------------------------------------------------------
*.bak
*.orig
*.rej

# ---- 日志与崩溃转储 -----------------------------------------------------
*.log
hs_err_pid*.log
replay_pid*.log

# ---- 临时报告与反汇编输出 -----------------------------------------------
# 开发过程中产生的各类 .txt 报告；需长期保留的结论应写入 docs/。
*.txt
!TEMPLATE_LICENSE.txt
!开发任务书.txt
!native/tools/*.txt
!native/tools/**/*.txt

# ---- 临时着色器与中间文件 -----------------------------------------------
# 根目录下形如 `vertex` 的临时着色器文件（转换器误留）
/vertex
/fragment
/unknown
*.spv
*.conv
*.es

# ---- 编辑器与 IDE -------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.code-workspace
.project
.classpath
.settings/
.factorypath
.eclipse
.apt_generated

# ---- Python 虚拟环境与缓存 ----------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- 操作系统 -----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
